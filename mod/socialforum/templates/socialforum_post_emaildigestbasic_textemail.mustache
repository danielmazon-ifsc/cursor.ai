{{!
    @template mod_socialforum/socialforum_post_emaildigestbasic_textemail

    Template which defines a social forum post for sending in a single-post text email.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * discussionlink
    * subject
    * authorfullname
    * postdate
}}

{{ discussionlink }}
{{{ subject }}} {{# str }} bynameondate, socialforum, {
        "name": {{# quote }}{{{ authorfullname }}}{{/ quote }},
        "date": {{# quote }}{{ postdate }}{{/ quote }}
    } {{/ str }}
---------------------------------------------------------------------
