<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/profile/db" VERSION="20250609" COMMENT="XMLDB file for Moodle local/profile"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_profile" COMMENT="Store data on profile updates">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="updatetime" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last time in which user's profile was updated."/>
        <FIELD NAME="nummonths" TYPE="int" LENGTH="3" NOTNULL="true" SEQUENCE="false" COMMENT="Number of total months of enrolment"/>
        <FIELD NAME="numupdates" TYPE="int" LENGTH="1" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="hiredate" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="true" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
